# ---- Supabase ----
# Project Settings > API in your Supabase dashboard
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-side only, NEVER expose to the frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Brevo (transactional email) ----
# Settings > SMTP & API > API Keys in your Brevo dashboard
BREVO_API_KEY=your-brevo-api-key
# Must be a sender verified in Brevo (Senders, Domains & Dedicated IPs)
BREVO_SENDER_EMAIL=hello@robothinkcollincounty.com
BREVO_SENDER_NAME=RoboThink Collin County
# Where lead notifications get sent
ADMIN_NOTIFICATION_EMAIL=you@example.com

# ---- Admin seed script (scripts/create-admin.js) ----
ADMIN_EMAIL=admin@robothinkcollincounty.com
ADMIN_PASSWORD=change-this-before-running-the-script

# ---- Stripe ----
# Developers > API keys in your Stripe dashboard (use the "test mode" keys until you're ready to go live)
STRIPE_SECRET_KEY=sk_test_...
# Created when you register the webhook endpoint (Developers > Webhooks), or printed by
# `stripe listen` when testing locally — see README-BACKEND.md
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Analytics (optional) ----
# GA4 Measurement ID. Leave blank to disable analytics entirely (no script
# loads, no events fire). Must be prefixed VITE_ to be exposed to the frontend.
VITE_GA_MEASUREMENT_ID=

# ---- Local dev only ----
PORT=8888
# Used to build Stripe Checkout success/cancel URLs when there's no request Origin header
APP_BASE_URL=http://localhost:8888
